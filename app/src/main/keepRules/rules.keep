# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Keep class/member names while shrinking remains active.
-dontobfuscate

# Keep Yomi domain/data/auth models and BuildConfig
-keep class com.yomi.reader.BuildConfig { *; }
-keep class com.yomi.reader.auth.** { *; }
-keep class com.yomi.reader.domain.model.** { *; }
-keep class com.yomi.reader.data.local.entity.** { *; }
-keep class com.yomi.reader.ui.viewer.annotation.** { *; }
-keep class com.yomi.reader.util.conversion.LibreOfficeConversionService { *; }

# Keep LibreOfficeKit JNI classes, ByteBuffer handle fields, and native callback methods
-keep class org.libreoffice.kit.** { *; }

# Keep RoomDatabase subclasses (WorkManager's WorkDatabase_Impl) & WorkManager / Startup
# classes whose constructors are invoked via reflection under R8 full mode.
-keep class * extends androidx.room.RoomDatabase { *; }
-keep class androidx.room.** { *; }
-keep class androidx.work.** { *; }
-keep class androidx.startup.** { *; }

# Google Credential Manager & Play Services Identity / Auth
-keep class androidx.credentials.** { *; }
-keep class com.google.android.gms.auth.** { *; }
-keep class com.google.android.gms.common.** { *; }
-keep class com.google.android.libraries.identity.googleid.** { *; }