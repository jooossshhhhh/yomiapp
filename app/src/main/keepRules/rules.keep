# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Skip class/member renaming pass so R8 naming dictionary does not OOM over
# Apache POI / OpenXML XMLBeans' 10k+ generated schema classes while keeping shrinking active.
-dontobfuscate

# Keep Yomi domain/data/auth models and BuildConfig
-keep class com.yomi.reader.BuildConfig { *; }
-keep class com.yomi.reader.auth.** { *; }
-keep class com.yomi.reader.domain.model.** { *; }
-keep class com.yomi.reader.data.local.entity.** { *; }
-keep class com.yomi.reader.ui.viewer.annotation.** { *; }

# Apache POI, OpenXML schemas, and XMLBeans reflection / schema loading
-keep class org.apache.poi.** { *; }
-keep class org.openxmlformats.schemas.** { *; }
-keep class org.apache.xmlbeans.** { *; }
-keep class schemaorg_apache_xmlbeans.** { *; }
-keep class com.microsoft.schemas.** { *; }
-keep class org.etsi.uri.** { *; }
-keep class org.w3.** { *; }

# Google Credential Manager & Play Services Identity / Auth
-keep class androidx.credentials.** { *; }
-keep class com.google.android.gms.auth.** { *; }
-keep class com.google.android.gms.common.** { *; }
-keep class com.google.android.libraries.identity.googleid.** { *; }

# Suppress optional desktop-only / third-party transitive references from Apache POI
-dontwarn java.awt.**
-dontwarn javax.swing.**
-dontwarn javax.imageio.**
-dontwarn java.beans.**
-dontwarn org.apache.poi.**
-dontwarn org.apache.xmlbeans.**
-dontwarn org.openxmlformats.schemas.**
-dontwarn org.apache.batik.**
-dontwarn org.bouncycastle.**
-dontwarn com.graphbuilder.**
-dontwarn org.apache.commons.**
-dontwarn org.apache.logging.**
-dontwarn de.rototor.**
-dontwarn com.zaxxer.**